<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Capa de presentación (MVVM): estado de pantalla y comandos, sin referencias a WPF.
    Front = PulsoWin.App (vistas) · Presentación = este proyecto · Back = PulsoWin.Core.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>PulsoWin.Presentation</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\PulsoWin.Core\PulsoWin.Core.csproj" />
  </ItemGroup>
</Project>
