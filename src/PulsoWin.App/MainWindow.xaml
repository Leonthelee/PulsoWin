<!--
  Vista principal. Solo diseño y enlaces (bindings): toda la lógica está en PulsoWin.Presentation (MainViewModel).
-->
<Window x:Class="PulsoWin.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:PulsoWin.App.Controls"
        Title="PulsoWin · limpiador y visor de hardware"
        Width="1180" Height="800" MinWidth="900" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}"
        FontFamily="{StaticResource BodyFont}" FontSize="13">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!-- Marcador del HUD (CPU, RAM, GPU) -->
        <Style x:Key="HudLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource TextDim}" />
        </Style>
        <Style x:Key="HudValue" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource Text}" />
        </Style>
        <Style x:Key="HudChip" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Surface}" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="MinWidth" Value="92" />
        </Style>

        <DataTemplate x:Key="SelectCell">
            <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                      HorizontalAlignment="Center" VerticalAlignment="Center"
                      AutomationProperties.Name="{Binding Name}" />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===================== CABECERA ===================== -->
        <Border Padding="20,14,20,10">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#1A1335" Offset="0" />
                    <GradientStop Color="#0E0B1A" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <controls:RetroPadHero Height="190" HorizontalAlignment="Left"
                                       IsActive="{Binding IsBusy}" Caption="{Binding HeroCaption}" />

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="PULSO" FontFamily="{StaticResource DisplayFont}" FontSize="38" FontWeight="Bold"
                                   Foreground="{StaticResource Text}" />
                        <TextBlock Text="WIN" FontFamily="{StaticResource DisplayFont}" FontSize="38" FontWeight="Bold"
                                   Foreground="{StaticResource Magenta}" Effect="{StaticResource MagentaGlow}" />
                        <Border Margin="10,0,0,6" VerticalAlignment="Bottom" CornerRadius="6" Padding="7,2"
                                BorderBrush="{StaticResource Cyan}" BorderThickness="1">
                            <TextBlock Text="{Binding VersionText}" FontFamily="{StaticResource MonoFont}" FontSize="11"
                                       Foreground="{StaticResource Cyan}" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Limpia lo que sobra. Mira lo que importa." Style="{StaticResource Muted}" Margin="2,0,0,12" />

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <Border Style="{StaticResource HudChip}">
                            <StackPanel>
                                <TextBlock Text="CPU" Style="{StaticResource HudLabel}" />
                                <TextBlock Text="{Binding Hardware.CpuText}" Style="{StaticResource HudValue}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource HudChip}">
                            <StackPanel>
                                <TextBlock Text="RAM" Style="{StaticResource HudLabel}" />
                                <TextBlock Text="{Binding Hardware.RamText}" Style="{StaticResource HudValue}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource HudChip}">
                            <StackPanel>
                                <TextBlock Text="GPU" Style="{StaticResource HudLabel}" />
                                <TextBlock Text="{Binding Hardware.GpuTempText}" Style="{StaticResource HudValue}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource HudChip}" BorderBrush="{StaticResource Magenta}">
                            <StackPanel>
                                <TextBlock Text="LIBERABLE" Style="{StaticResource HudLabel}" />
                                <TextBlock Text="{Binding Clean.FreeableText}" Style="{StaticResource HudValue}"
                                           Foreground="{StaticResource Magenta}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <Button Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" FontSize="18" Padding="28,10"
                            Command="{Binding StartCommand}" ToolTip="Analiza qué se puede liberar. No borra nada todavía."
                            AutomationProperties.Name="Start: analizar">
                        <TextBlock Text="▶  START" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===================== PESTAÑAS ===================== -->
        <TabControl Grid.Row="1" Margin="20,4,20,0" SelectedIndex="{Binding SelectedTab}">

            <!-- LIMPIAR -->
            <TabItem Header="LIMPIAR" DataContext="{Binding Clean}">
                <Border Style="{StaticResource Card}" CornerRadius="0,12,12,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="*" MinWidth="270" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <DataGrid ItemsSource="{Binding Rules}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="" Width="40" CellTemplate="{StaticResource SelectCell}" />
                                <DataGridTextColumn Header="ELEMENTO" Binding="{Binding Name}" IsReadOnly="True" Width="2.6*" MinWidth="230" />
                                <DataGridTextColumn Header="CATEGORÍA" Binding="{Binding Category}" IsReadOnly="True" Width="*" />
                                <DataGridTextColumn Header="TAMAÑO" Binding="{Binding SizeText}" IsReadOnly="True" Width="90" />
                                <DataGridTextColumn Header="ESTADO" Binding="{Binding Status}" IsReadOnly="True" Width="1.8*" />
                            </DataGrid.Columns>
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Setter Property="ToolTip" Value="{Binding Note}" />
                                </Style>
                            </DataGrid.RowStyle>
                        </DataGrid>

                        <ScrollViewer Grid.Column="1" Margin="16,0,0,0" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="COOKIES" Style="{StaticResource Heading}" />
                                <CheckBox Content="Borrar cookies" IsChecked="{Binding DeleteCookies}" Margin="0,0,0,6" />
                                <TextBlock Style="{StaticResource Muted}"
                                           Text="Solo con el navegador cerrado. Antes de borrar se guarda una copia de respaldo. Las sesiones guardadas en localStorage no se tocan." />
                                <TextBlock Text="Dominios que se conservan (uno por línea):" Margin="0,12,0,4" TextWrapping="Wrap" />
                                <TextBox Height="110" AcceptsReturn="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto"
                                         FontFamily="{StaticResource MonoFont}"
                                         Text="{Binding KeepText, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="Dominios cuyas cookies se conservan" />
                                <TextBlock Text="{Binding CookieInfo}" Style="{StaticResource Muted}" Margin="0,6,0,0" />

                                <TextBlock Text="ANTES / DESPUÉS" Style="{StaticResource Heading}" Margin="0,20,0,8" />
                                <Border Background="{StaticResource SurfaceAlt}" CornerRadius="8" Padding="10"
                                        BorderBrush="{StaticResource Line}" BorderThickness="1">
                                    <TextBlock Text="{Binding BeforeAfter}" TextWrapping="Wrap" FontFamily="{StaticResource MonoFont}"
                                               Foreground="{StaticResource Green}" LineHeight="20" />
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                            <Button Style="{StaticResource SecondaryButton}" Content="Analizar" Margin="0,0,10,0"
                                    Command="{Binding ScanCommand}" ToolTip="Solo mira; no borra nada." />
                            <Button Style="{StaticResource PrimaryButton}" Content="Limpiar…" Command="{Binding CleanCommand}"
                                    ToolTip="Pide confirmación antes de borrar." />
                        </StackPanel>
                    </Grid>
                </Border>
            </TabItem>

            <!-- HARDWARE -->
            <TabItem Header="HARDWARE" DataContext="{Binding Hardware}">
                <Border Style="{StaticResource Card}" CornerRadius="0,12,12,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="1.15*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="RESUMEN DEL EQUIPO" Style="{StaticResource Heading}" />
                        <DataGrid Grid.Row="1" ItemsSource="{Binding Summary}" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="COMPONENTE" Binding="{Binding Section}" Width="130" />
                                <DataGridTextColumn Header="DETALLE" Binding="{Binding Value}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock Grid.Column="1" Text="SENSORES EN VIVO · CADA 2 S" Style="{StaticResource Heading}" Margin="16,0,0,8" />
                        <DataGrid Grid.Row="1" Grid.Column="1" Margin="16,0,0,0" ItemsSource="{Binding Sensors}" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="SENSOR" Binding="{Binding Label}" Width="2.4*" MinWidth="200" />
                                <DataGridTextColumn Header="VALOR" Binding="{Binding Display}" Width="115" />
                                <DataGridTextColumn Header="NOTA" Binding="{Binding Note}" Width="1.6*" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Margin="0,10,0,0" Style="{StaticResource Muted}"
                                   Text="Temperaturas de CPU, voltajes y ventiladores de placa necesitan un driver de kernel; PulsoWin no instala ninguno y los muestra como «no disponible» en vez de inventar un valor." />
                    </Grid>
                </Border>
            </TabItem>

            <!-- ACTUALIZAR -->
            <TabItem Header="ACTUALIZAR" DataContext="{Binding Updates}">
                <Border Style="{StaticResource Card}" CornerRadius="0,12,12,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="*" MinWidth="270" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="PROGRAMAS CON ACTUALIZACIÓN (WINGET)" Style="{StaticResource Heading}" />
                        <DataGrid Grid.Row="1" ItemsSource="{Binding Packages}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="" Width="40" CellTemplate="{StaticResource SelectCell}" />
                                <DataGridTextColumn Header="APLICACIÓN" Binding="{Binding Name}" IsReadOnly="True" Width="2*" />
                                <DataGridTextColumn Header="ID" Binding="{Binding Id}" IsReadOnly="True" Width="1.6*" />
                                <DataGridTextColumn Header="ACTUAL" Binding="{Binding InstalledVersion}" IsReadOnly="True" Width="90" />
                                <DataGridTextColumn Header="NUEVA" Binding="{Binding AvailableVersion}" IsReadOnly="True" Width="90" />
                                <DataGridTextColumn Header="ESTADO" Binding="{Binding Status}" IsReadOnly="True" Width="1.4*" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock Grid.Column="1" Text="WINDOWS UPDATE · SOLO LECTURA" Style="{StaticResource Heading}" Margin="16,0,0,8" />
                        <DockPanel Grid.Row="1" Grid.Column="1" Margin="16,0,0,0">
                            <TextBlock DockPanel.Dock="Top" Text="{Binding WindowsUpdateStatus}" Style="{StaticResource Muted}" Margin="0,0,0,8" />
                            <Button DockPanel.Dock="Bottom" Style="{StaticResource SecondaryButton}" Content="Abrir Windows Update"
                                    Margin="0,10,0,0" HorizontalAlignment="Left" Command="{Binding OpenWindowsUpdateCommand}" />
                            <DataGrid ItemsSource="{Binding WindowsUpdates}" IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="KB" Binding="{Binding KbId}" Width="90" />
                                    <DataGridTextColumn Header="ACTUALIZACIÓN" Binding="{Binding Title}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>

                        <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                            <Button Style="{StaticResource SecondaryButton}" Content="Buscar actualizaciones" Margin="0,0,10,0"
                                    Command="{Binding SearchCommand}" ToolTip="Solo consulta; no instala nada." />
                            <Button Style="{StaticResource PrimaryButton}" Content="Actualizar marcados…"
                                    Command="{Binding UpgradeSelectedCommand}" ToolTip="Pide confirmación antes de instalar." />
                        </StackPanel>
                    </Grid>
                </Border>
            </TabItem>
        </TabControl>

        <!-- ===================== BARRA DE ESTADO ===================== -->
        <Border Grid.Row="2" Margin="20,10,20,12" Padding="12,7" CornerRadius="8"
                Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1">
            <DockPanel>
                <Ellipse DockPanel.Dock="Left" Width="8" Height="8" Margin="0,0,10,0" VerticalAlignment="Center"
                         Fill="{StaticResource Green}" />
                <TextBlock Text="{Binding Status.Message}" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis"
                           AutomationProperties.LiveSetting="Polite" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
