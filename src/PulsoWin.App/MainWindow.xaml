<Window x:Class="PulsoWin.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PulsoWin · limpiador y visor de hardware"
        Width="1040" Height="700" MinWidth="780" MinHeight="520"
        WindowStartupLocation="CenterScreen">
    <DockPanel Margin="12">
        <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" Margin="2,8,0,0"
                   Style="{StaticResource Muted}" Text="Listo. Pulsa «Analizar» para ver qué se puede liberar." />

        <TabControl>
            <!-- ===================== LIMPIAR ===================== -->
            <TabItem Header="Limpiar">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="*" MinWidth="260" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <DataGrid x:Name="RulesGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                              CanUserDeleteRows="False" HeadersVisibility="Column" SelectionMode="Single"
                              GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="" Width="36">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Elemento" Binding="{Binding Name}" IsReadOnly="True" Width="2*" />
                            <DataGridTextColumn Header="Categoría" Binding="{Binding Category}" IsReadOnly="True" Width="*" />
                            <DataGridTextColumn Header="Tamaño" Binding="{Binding SizeText}" IsReadOnly="True" Width="90" />
                            <DataGridTextColumn Header="Estado" Binding="{Binding Status}" IsReadOnly="True" Width="2*" />
                        </DataGrid.Columns>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="ToolTip" Value="{Binding Note}" />
                            </Style>
                        </DataGrid.RowStyle>
                    </DataGrid>

                    <ScrollViewer Grid.Column="1" Margin="14,0,0,0" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Cookies" Style="{StaticResource Heading}" />
                            <CheckBox x:Name="CookiesCheck" Content="Borrar cookies" Margin="0,0,0,4" />
                            <TextBlock Style="{StaticResource Muted}"
                                       Text="Solo con el navegador cerrado. Antes de borrar se guarda una copia de respaldo. Las sesiones guardadas en localStorage no se tocan." />
                            <TextBlock Text="Dominios que se conservan (uno por línea):" Margin="0,10,0,4" TextWrapping="Wrap" />
                            <TextBox x:Name="KeepBox" Height="120" AcceptsReturn="True" TextWrapping="NoWrap"
                                     VerticalScrollBarVisibility="Auto" FontFamily="Consolas" />
                            <TextBlock x:Name="CookieInfo" Style="{StaticResource Muted}" Margin="0,6,0,0" />

                            <TextBlock Text="Antes / después" Style="{StaticResource Heading}" Margin="0,18,0,6" />
                            <TextBlock x:Name="BeforeAfterText" TextWrapping="Wrap"
                                       Text="Todavía no has limpiado en esta sesión." />
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal"
                                HorizontalAlignment="Right" Margin="0,10,0,0">
                        <Button x:Name="ScanButton" Content="Analizar" Margin="0,0,8,0" Click="Scan_Click" />
                        <Button x:Name="CleanButton" Content="Limpiar…" IsEnabled="False" Click="Clean_Click" />
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- ===================== HARDWARE ===================== -->
            <TabItem Header="Hardware">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="Resumen del equipo" Style="{StaticResource Heading}" />
                    <DataGrid x:Name="SummaryGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Componente" Binding="{Binding Section}" Width="120" />
                            <DataGridTextColumn Header="Detalle" Binding="{Binding Value}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Grid.Column="1" Text="Sensores en vivo (cada 2 s)" Style="{StaticResource Heading}" Margin="14,0,0,6" />
                    <DataGrid x:Name="SensorsGrid" Grid.Row="1" Grid.Column="1" Margin="14,0,0,0"
                              AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Sensor" Binding="{Binding Label}" Width="2*" />
                            <DataGridTextColumn Header="Valor" Binding="{Binding Display}" Width="90" />
                            <DataGridTextColumn Header="Fuente" Binding="{Binding Source}" Width="*" />
                            <DataGridTextColumn Header="Nota" Binding="{Binding Note}" Width="2*" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Margin="0,8,0,0" Style="{StaticResource Muted}"
                               Text="Temperaturas de CPU, voltajes y ventiladores de placa necesitan un driver de kernel; esta versión no instala ninguno y los muestra como «no disponible» en vez de inventar un valor." />
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
