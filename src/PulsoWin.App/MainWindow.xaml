<!--
  Vista principal. Solo diseño y enlaces (bindings): toda la lógica está en PulsoWin.Presentation (MainViewModel).
-->
<Window x:Class="PulsoWin.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:PulsoWin.App.Controls"
        Title="PulsoWin · limpiador y visor de hardware"
        Icon="Assets/pulsowin.ico"
        Width="1240" Height="860" MinWidth="980" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}"
        FontFamily="{StaticResource BodyFont}" FontSize="13">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!-- Marcador del HUD (CPU, RAM, GPU) -->
        <Style x:Key="HudLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource TextDim}" />
        </Style>
        <Style x:Key="HudValue" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource Text}" />
        </Style>
        <Style x:Key="HudCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Surface}" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <!-- Alto fijo: el top tiene de 0 a 3 líneas y, si el alto cambiara, toda la pantalla saltaría cada 2 s -->
            <Setter Property="Height" Value="74" />
        </Style>

        <!-- Una línea del top: nombre del programa (recortado) y su consumo -->
        <DataTemplate x:Key="TopItem">
            <Grid Margin="0,1" ToolTip="{Binding Processes, StringFormat='{}{0} proceso(s) con este nombre'}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextDim}" FontSize="12"
                           TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
                <TextBlock Grid.Column="1" Text="{Binding Display}" Foreground="{StaticResource Text}"
                           FontFamily="{StaticResource MonoFont}" FontSize="12" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="SelectCell">
            <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                      HorizontalAlignment="Center" VerticalAlignment="Center"
                      AutomationProperties.Name="{Binding Name}" />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===================== CABECERA ===================== -->
        <Border Padding="20,14,20,10">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#1A1335" Offset="0" />
                    <GradientStop Color="#0E0B1A" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <controls:RetroPadHero Height="165" HorizontalAlignment="Left"
                                       IsActive="{Binding IsBusy}" Caption="{Binding HeroCaption}" />

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="PULSO" FontFamily="{StaticResource DisplayFont}" FontSize="38" FontWeight="Bold"
                                   Foreground="{StaticResource Text}" />
                        <TextBlock Text="WIN" FontFamily="{StaticResource DisplayFont}" FontSize="38" FontWeight="Bold"
                                   Foreground="{StaticResource Magenta}" Effect="{StaticResource MagentaGlow}" />
                        <Border Margin="10,0,0,6" VerticalAlignment="Bottom" CornerRadius="6" Padding="7,2"
                                BorderBrush="{StaticResource Cyan}" BorderThickness="1">
                            <TextBlock Text="{Binding VersionText}" FontFamily="{StaticResource MonoFont}" FontSize="11"
                                       Foreground="{StaticResource Cyan}" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Limpia lo que sobra. Mira lo que importa." Style="{StaticResource Muted}" Margin="2,0,0,12" />

                    <!-- START es de LIMPIAR: en ACTUALIZAR se desvanece (sin mover el diseño) y no responde a clic ni teclado. -->
                    <Button HorizontalAlignment="Left" FontSize="18" Padding="28,10"
                            Command="{Binding StartCommand}" ToolTip="Analiza qué se puede liberar. No borra nada todavía."
                            AutomationProperties.Name="Start: analizar">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsStartAvailable}" Value="False">
                                        <Setter Property="IsHitTestVisible" Value="False" />
                                        <Setter Property="Focusable" Value="False" />
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.35" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                        <DataTrigger.ExitActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.35" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.ExitActions>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <TextBlock Text="▶  START" />
                    </Button>
                </StackPanel>

                <!-- HUD: valor grande + top 3 de programas que más consumen -->
                <UniformGrid Grid.Row="1" Grid.ColumnSpan="2" Columns="4" Margin="0,10,-10,0">
                    <Border Style="{StaticResource HudCard}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="84" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="CPU" Style="{StaticResource HudLabel}" />
                                <TextBlock Text="{Binding Hardware.CpuText}" Style="{StaticResource HudValue}" />
                            </StackPanel>
                            <ItemsControl Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"
                                          ItemsSource="{Binding Hardware.TopCpu}" ItemTemplate="{StaticResource TopItem}" />
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource HudCard}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="84" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="RAM" Style="{StaticResource HudLabel}" />
                                <TextBlock Text="{Binding Hardware.RamText}" Style="{StaticResource HudValue}" />
                            </StackPanel>
                            <ItemsControl Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"
                                          ItemsSource="{Binding Hardware.TopRam}" ItemTemplate="{StaticResource TopItem}" />
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource HudCard}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="84" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="GPU" Style="{StaticResource HudLabel}" />
                                <TextBlock Text="{Binding Hardware.GpuTempText}" Style="{StaticResource HudValue}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                <ItemsControl ItemsSource="{Binding Hardware.TopGpu}" ItemTemplate="{StaticResource TopItem}" />
                                <TextBlock Text="{Binding Hardware.GpuTopNote}" Foreground="{StaticResource TextDim}" FontSize="12">
                                    <!-- Sin nota (hay top de GPU), la línea no ocupa espacio: si no, la tarjeta se desborda -->
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Hardware.GpuTopNote}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource HudCard}" BorderBrush="{StaticResource Magenta}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="84" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="LIBERABLE" Style="{StaticResource HudLabel}" />
                                <TextBlock Text="{Binding Clean.FreeableText}" Style="{StaticResource HudValue}" Foreground="{StaticResource Magenta}" />
                            </StackPanel>
                            <ItemsControl Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"
                                          ItemsSource="{Binding Clean.TopFreeable}" ItemTemplate="{StaticResource TopItem}" />
                        </Grid>
                    </Border>
                </UniformGrid>
            </Grid>
        </Border>

        <!-- ===================== PESTAÑAS ===================== -->
        <TabControl Grid.Row="1" Margin="20,4,20,0" SelectedIndex="{Binding SelectedTab}">

            <!-- LIMPIAR -->
            <TabItem Header="LIMPIAR" DataContext="{Binding Clean}">
                <Border Style="{StaticResource Card}" CornerRadius="0,12,12,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="*" MinWidth="270" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <DataGrid ItemsSource="{Binding Rules}" controls:GridMultiCheck.IsEnabled="True" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Width="44" CellTemplate="{StaticResource SelectCell}">
                                    <DataGridTemplateColumn.Header>
                                        <CheckBox HorizontalAlignment="Center" IsThreeState="False"
                                                  IsChecked="{Binding DataContext.AllSelected, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                  ToolTip="Seleccionar todo / nada" AutomationProperties.Name="Seleccionar todo" />
                                    </DataGridTemplateColumn.Header>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="ELEMENTO" Binding="{Binding Name}" IsReadOnly="True" Width="2.6*" MinWidth="230" />
                                <DataGridTextColumn Header="CATEGORÍA" Binding="{Binding Category}" IsReadOnly="True" Width="*" />
                                <DataGridTextColumn Header="TAMAÑO" Binding="{Binding SizeText}" IsReadOnly="True" Width="90" />
                                <DataGridTextColumn Header="ESTADO" Binding="{Binding Status}" IsReadOnly="True" Width="1.8*" />
                            </DataGrid.Columns>
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Setter Property="ToolTip" Value="{Binding Note}" />
                                </Style>
                            </DataGrid.RowStyle>
                        </DataGrid>

                        <ScrollViewer Grid.Column="1" Margin="16,0,0,0" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
                            <StackPanel>
                                <TextBlock Text="COOKIES" Style="{StaticResource Heading}" />
                                <CheckBox Content="Borrar cookies" IsChecked="{Binding DeleteCookies}" Margin="0,0,0,6" />
                                <TextBlock Style="{StaticResource Muted}"
                                           Text="Solo con el navegador cerrado. Antes de borrar se guarda una copia de respaldo. Las sesiones guardadas en localStorage no se tocan." />
                                <TextBlock Text="Dominios que se conservan (uno por línea):" Margin="0,12,0,4" TextWrapping="Wrap" />
                                <TextBox Height="110" AcceptsReturn="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto"
                                         FontFamily="{StaticResource MonoFont}"
                                         Text="{Binding KeepText, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="Dominios cuyas cookies se conservan" />
                                <TextBlock Text="{Binding CookieInfo}" Style="{StaticResource Muted}" Margin="0,6,0,0" />

                                <TextBlock Text="ANTES / DESPUÉS" Style="{StaticResource Heading}" Margin="0,20,0,8" />
                                <Border Background="{StaticResource SurfaceAlt}" CornerRadius="8" Padding="10"
                                        BorderBrush="{StaticResource Line}" BorderThickness="1">
                                    <TextBlock Text="{Binding BeforeAfter}" TextWrapping="Wrap" FontFamily="{StaticResource MonoFont}"
                                               Foreground="{StaticResource Green}" LineHeight="20" />
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                            <Button Style="{StaticResource SecondaryButton}" Content="Analizar" Margin="0,0,10,0"
                                    Command="{Binding ScanCommand}" ToolTip="Solo mira; no borra nada." />
                            <Button Style="{StaticResource PrimaryButton}" Content="Limpiar…" Command="{Binding CleanCommand}"
                                    ToolTip="Pide confirmación antes de borrar." />
                        </StackPanel>
                    </Grid>
                </Border>
            </TabItem>

            <!-- HARDWARE -->
            <TabItem Header="HARDWARE" DataContext="{Binding Hardware}">
                <Border Style="{StaticResource Card}" CornerRadius="0,12,12,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="1.15*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="RESUMEN DEL EQUIPO" Style="{StaticResource Heading}" />
                        <DataGrid Grid.Row="1" ItemsSource="{Binding Summary}" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="COMPONENTE" Binding="{Binding Section}" Width="130" />
                                <DataGridTextColumn Header="DETALLE" Binding="{Binding Value}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock Grid.Column="1" Text="SENSORES EN VIVO · CADA 2 S" Style="{StaticResource Heading}" Margin="16,0,0,8" />
                        <DataGrid Grid.Row="1" Grid.Column="1" Margin="16,0,0,0" ItemsSource="{Binding Sensors}" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="SENSOR" Binding="{Binding Label}" Width="2.4*" MinWidth="200" />
                                <DataGridTextColumn Header="VALOR" Binding="{Binding Display}" Width="115" />
                                <DataGridTextColumn Header="NOTA" Binding="{Binding Note}" Width="1.6*" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Margin="0,10,0,0" Style="{StaticResource Muted}"
                                   Text="Temperaturas de CPU, voltajes y ventiladores de placa necesitan un driver de kernel; PulsoWin no instala ninguno y los muestra como «no disponible» en vez de inventar un valor." />
                    </Grid>
                </Border>
            </TabItem>

            <!-- ACTUALIZAR: buscar en segundo plano -> lista única -> proceder, sin salir de PulsoWin -->
            <TabItem Header="ACTUALIZAR" DataContext="{Binding Updates}">
                <Border Style="{StaticResource Card}" CornerRadius="0,12,12,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="ACTUALIZACIONES PENDIENTES · WINDOWS Y PROGRAMAS" Style="{StaticResource Heading}" />
                        <StackPanel Grid.Row="1" Margin="0,0,0,10">
                            <TextBlock Text="{Binding Summary}" Style="{StaticResource Muted}" AutomationProperties.LiveSetting="Polite" />
                            <ProgressBar Height="4" Margin="0,8,0,0" IsIndeterminate="{Binding IsBusy}"
                                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>

                        <DataGrid Grid.Row="2" ItemsSource="{Binding Items}" controls:GridMultiCheck.IsEnabled="True" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Width="44" CellTemplate="{StaticResource SelectCell}">
                                    <DataGridTemplateColumn.Header>
                                        <CheckBox HorizontalAlignment="Center" IsThreeState="False"
                                                  IsChecked="{Binding DataContext.AllSelected, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                  ToolTip="Seleccionar todo / nada" AutomationProperties.Name="Seleccionar todo" />
                                    </DataGridTemplateColumn.Header>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="TIPO" Binding="{Binding KindText}" IsReadOnly="True" Width="90" />
                                <DataGridTextColumn Header="NOMBRE" Binding="{Binding Name}" IsReadOnly="True" Width="3*" />
                                <DataGridTextColumn Header="ACTUAL" Binding="{Binding CurrentVersion}" IsReadOnly="True" Width="95" />
                                <DataGridTextColumn Header="NUEVA / KB" Binding="{Binding NewVersion}" IsReadOnly="True" Width="110" />
                                <DataGridTextColumn Header="TAMAÑO" Binding="{Binding SizeText}" IsReadOnly="True" Width="85" />
                                <DataGridTextColumn Header="ESTADO" Binding="{Binding Status}" IsReadOnly="True" Width="1.6*" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                            <Button Style="{StaticResource SecondaryButton}" Content="Buscar actualizaciones" Margin="0,0,10,0"
                                    Command="{Binding SearchCommand}" ToolTip="Revisa en segundo plano; no instala nada."
                                    AutomationProperties.Name="Buscar actualizaciones" />
                            <Button Style="{StaticResource PrimaryButton}" Content="Proceder con las actualizaciones…"
                                    Command="{Binding ProceedCommand}"
                                    ToolTip="Pide confirmación y, para las de Windows, un permiso de administrador." />
                        </StackPanel>
                    </Grid>
                </Border>
            </TabItem>

            <!-- RED: top 10 de tráfico en vivo. Arranca con la ventana, aunque la pestaña no esté abierta. -->
            <TabItem Header="RED" DataContext="{Binding Network}">
                <Border Style="{StaticResource Card}" CornerRadius="0,12,12,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <DockPanel>
                            <Border DockPanel.Dock="Right" CornerRadius="6" Padding="8,2" VerticalAlignment="Center"
                                    BorderBrush="{StaticResource Cyan}" BorderThickness="1">
                                <TextBlock Text="{Binding ModeText}" FontFamily="{StaticResource MonoFont}" FontSize="11"
                                           Foreground="{StaticResource Cyan}" />
                            </Border>
                            <TextBlock Text="Aquí te muestro tu tráfico de red actual (los primeros 10)"
                                       Style="{StaticResource Heading}" FontSize="16" />
                        </DockPanel>

                        <!-- Aviso discreto: modo usuario estándar o motivo del modo por interfaz -->
                        <TextBlock Grid.Row="1" Text="{Binding Notice}" Style="{StaticResource Muted}" Margin="0,2,0,10"
                                   AutomationProperties.LiveSetting="Polite" />

                        <DataGrid Grid.Row="2" ItemsSource="{Binding Items}" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="PID" Binding="{Binding PidText}" Width="80" />
                                <DataGridTextColumn Header="PROCESO" Binding="{Binding Process}" Width="2*" />
                                <DataGridTextColumn Header="DESCARGA (RX)" Binding="{Binding RxText}" Width="*" />
                                <DataGridTextColumn Header="SUBIDA (TX)" Binding="{Binding TxText}" Width="*" />
                                <DataGridTextColumn Header="TOTAL SESIÓN" Binding="{Binding SessionTotalText}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </TabItem>
        </TabControl>

        <!-- ===================== BARRA DE ESTADO ===================== -->
        <Border Grid.Row="2" Margin="20,10,20,12" Padding="12,7" CornerRadius="8"
                Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1">
            <DockPanel>
                <Ellipse DockPanel.Dock="Left" Width="8" Height="8" Margin="0,0,10,0" VerticalAlignment="Center"
                         Fill="{StaticResource Green}" />
                <TextBlock Text="{Binding Status.Message}" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis"
                           AutomationProperties.LiveSetting="Polite" />
            </DockPanel>
        </Border>

        <!-- ===================== HUEVO DE PASCUA: código Konami (↑ ↑ ↓ ↓ ← → ← → B A) ===================== -->
        <Grid Grid.RowSpan="3" Background="#D90E0B1A"
              Visibility="{Binding IsEasterEggOpen, Converter={StaticResource BoolToVisibility}}">
            <Border Width="560" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="32,26" CornerRadius="16"
                    Background="{StaticResource Surface}" BorderBrush="{StaticResource Magenta}" BorderThickness="2"
                    Effect="{StaticResource MagentaGlow}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,6">
                        <Image Source="Assets/pulsowin.ico" Width="48" Height="48" Margin="0,0,14,0" />
                        <TextBlock Text="CHEAT CODE DESBLOQUEADO" FontFamily="{StaticResource DisplayFont}" FontSize="24"
                                   FontWeight="Bold" Foreground="{StaticResource Magenta}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="↑ ↑ ↓ ↓ ← → ← → B A" HorizontalAlignment="Center" FontFamily="{StaticResource MonoFont}"
                               FontSize="14" Foreground="{StaticResource Cyan}" Margin="0,0,0,18" />

                    <TextBlock Text="HECHO POR" Style="{StaticResource Heading}" Margin="0,0,0,2" />
                    <TextBlock Text="{Binding Signature.Author}" FontFamily="{StaticResource DisplayFont}" FontSize="20"
                               FontWeight="SemiBold" Foreground="{StaticResource Text}" TextWrapping="Wrap" />
                    <TextBlock Margin="0,4,0,16">
                        <Hyperlink x:Name="ProfileLink" Click="ProfileLink_Click" Foreground="{StaticResource Cyan}"
                                   ToolTip="Abrir el perfil en el navegador">
                            <Run Text="{Binding Signature.Profile, Mode=OneWay}" />
                        </Hyperlink>
                    </TextBlock>

                    <Border Background="{StaticResource SurfaceAlt}" CornerRadius="8" Padding="12,10"
                            BorderBrush="{StaticResource Line}" BorderThickness="1">
                        <TextBlock Text="{Binding Signature.HelloDev}" TextWrapping="Wrap" FontFamily="{StaticResource MonoFont}"
                                   Foreground="{StaticResource Green}" LineHeight="20" />
                    </Border>

                    <TextBlock Text="Co-desarrollo: Claude (Anthropic) y Antigravity (Google)." Style="{StaticResource Muted}"
                               Margin="0,14,0,18" />
                    <Button Style="{StaticResource PrimaryButton}" Content="Volver al juego  (Esc)" HorizontalAlignment="Center"
                            Command="{Binding CloseEasterEggCommand}" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
