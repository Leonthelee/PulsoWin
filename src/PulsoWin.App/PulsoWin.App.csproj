<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>PulsoWin</AssemblyName>
    <RootNamespace>PulsoWin.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- SHQUERYRBINFO cambia de tamaño en x86; la app se publica solo para 64 bits. -->
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <ItemGroup>
    <!-- El front solo conoce la capa de presentación; Core llega de forma transitiva. -->
    <ProjectReference Include="..\PulsoWin.Presentation\PulsoWin.Presentation.csproj" />
  </ItemGroup>
</Project>
