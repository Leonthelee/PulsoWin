<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Solo para el ícono de la bandeja (NotifyIcon) del Modo Gadget; viene con .NET, sin paquetes extra. -->
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>PulsoWin</AssemblyName>
    <RootNamespace>PulsoWin.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- WFO0003 pide declarar el DPI con la API de Windows Forms, pero la ventana es WPF: WPF lo lee del manifiesto
         (requisito 1.3 de Windows). Forms solo pone el ícono de la bandeja. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
    <!-- SHQUERYRBINFO cambia de tamaño en x86; la app se publica solo para 64 bits. -->
    <PlatformTarget>x64</PlatformTarget>
    <!-- Ícono del .exe (Explorador, accesos directos). Lo genera tools/icon.cs a partir del diseño del mando. -->
    <ApplicationIcon>Assets\pulsowin.ico</ApplicationIcon>
  </PropertyGroup>
  <!-- El MSI y el paquete self-contained empaquetan el runtime de .NET: fijar >= 10.0.14 mitiga CVE-2026-111497 (Brotli). -->
  <PropertyGroup>
    <PulsoWinRuntimeVersion>10.0.15</PulsoWinRuntimeVersion>
  </PropertyGroup>
  <ItemGroup>
    <KnownFrameworkReference Update="Microsoft.NETCore.App;Microsoft.WindowsDesktop.App"
                             LatestRuntimeFrameworkVersion="$(PulsoWinRuntimeVersion)" />
  </ItemGroup>
  <ItemGroup>
    <!-- Windows Forms y System.Drawing NO van como usings implícitos: chocarían con los tipos de WPF
         (Application, MessageBox, Point, Color…). Se usan con el alias explícito "Forms". -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>
  <ItemGroup>
    <!-- El mismo ícono para la barra de título y la barra de tareas. -->
    <Resource Include="Assets\pulsowin.ico" />
  </ItemGroup>
  <ItemGroup>
    <!-- El front solo conoce la capa de presentación; Core llega de forma transitiva. -->
    <ProjectReference Include="..\PulsoWin.Presentation\PulsoWin.Presentation.csproj" />
  </ItemGroup>
</Project>
