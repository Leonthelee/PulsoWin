<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Solo para el ícono de la bandeja (NotifyIcon) del Modo Gadget; viene con .NET, sin paquetes extra. -->
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>PulsoWin</AssemblyName>
    <RootNamespace>PulsoWin.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- SHQUERYRBINFO cambia de tamaño en x86; la app se publica solo para 64 bits. -->
    <PlatformTarget>x64</PlatformTarget>
    <!-- Ícono del .exe (Explorador, accesos directos). Lo genera tools/icon.cs a partir del diseño del mando. -->
    <ApplicationIcon>Assets\pulsowin.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <!-- Windows Forms y System.Drawing NO van como usings implícitos: chocarían con los tipos de WPF
         (Application, MessageBox, Point, Color…). Se usan con el alias explícito "Forms". -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>
  <ItemGroup>
    <!-- El mismo ícono para la barra de título y la barra de tareas. -->
    <Resource Include="Assets\pulsowin.ico" />
  </ItemGroup>
  <ItemGroup>
    <!-- El front solo conoce la capa de presentación; Core llega de forma transitiva. -->
    <ProjectReference Include="..\PulsoWin.Presentation\PulsoWin.Presentation.csproj" />
  </ItemGroup>
</Project>
