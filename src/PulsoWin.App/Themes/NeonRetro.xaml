<!--
  Contrato visual "Neón retro" de PulsoWin (ATLAS).
  Regla: ningún color ni fuente se escribe a mano en una vista; todo sale de aquí.
  Contraste: texto #EDE9FF sobre fondo #0E0B1A ≈ 17:1; texto tenue #A79ED6 ≈ 8:1 (WCAG AA holgado).
  Fuentes incluidas en Windows 10/11: no se descarga ni se distribuye ninguna.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===================== Paleta ===================== -->
    <Color x:Key="BgColor">#0E0B1A</Color>
    <Color x:Key="SurfaceColor">#17132B</Color>
    <Color x:Key="SurfaceAltColor">#1D1836</Color>
    <Color x:Key="LineColor">#2E2754</Color>
    <Color x:Key="TextColor">#EDE9FF</Color>
    <Color x:Key="TextDimColor">#A79ED6</Color>
    <Color x:Key="MagentaColor">#FF3EA5</Color>
    <Color x:Key="CyanColor">#2DE2E6</Color>
    <Color x:Key="VioletColor">#7B5CFF</Color>
    <Color x:Key="GreenColor">#39FF88</Color>

    <SolidColorBrush x:Key="Bg" Color="{StaticResource BgColor}" />
    <SolidColorBrush x:Key="Surface" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="SurfaceAlt" Color="{StaticResource SurfaceAltColor}" />
    <SolidColorBrush x:Key="Line" Color="{StaticResource LineColor}" />
    <SolidColorBrush x:Key="Text" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="TextDim" Color="{StaticResource TextDimColor}" />
    <SolidColorBrush x:Key="Magenta" Color="{StaticResource MagentaColor}" />
    <SolidColorBrush x:Key="Cyan" Color="{StaticResource CyanColor}" />
    <SolidColorBrush x:Key="Green" Color="{StaticResource GreenColor}" />
    <SolidColorBrush x:Key="SelectionBg" Color="#3A2466" />

    <LinearGradientBrush x:Key="PrimaryGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource MagentaColor}" Offset="0" />
        <GradientStop Color="{StaticResource VioletColor}" Offset="1" />
    </LinearGradientBrush>

    <!-- ===================== Tipografía ===================== -->
    <FontFamily x:Key="DisplayFont">Bahnschrift</FontFamily>
    <FontFamily x:Key="BodyFont">Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFont">Consolas</FontFamily>

    <DropShadowEffect x:Key="MagentaGlow" Color="{StaticResource MagentaColor}" BlurRadius="18" ShadowDepth="0" Opacity="0.85" />
    <DropShadowEffect x:Key="CyanGlow" Color="{StaticResource CyanColor}" BlurRadius="14" ShadowDepth="0" Opacity="0.8" />

    <!-- ===================== Texto ===================== -->
    <Style x:Key="Heading" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Cyan}" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
    <Style x:Key="Muted" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextDim}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="LineHeight" Value="19" />
    </Style>

    <!-- ===================== Botones ===================== -->
    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="20,9" />
        <Setter Property="MinWidth" Value="130" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Body" CornerRadius="10" Background="{StaticResource PrimaryGradient}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Body" Property="Effect" Value="{StaticResource MagentaGlow}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Body" Property="RenderTransform">
                                <Setter.Value><ScaleTransform ScaleX="0.97" ScaleY="0.97" /></Setter.Value>
                            </Setter>
                            <Setter TargetName="Body" Property="RenderTransformOrigin" Value="0.5,0.5" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Body" Property="Effect" Value="{StaticResource CyanGlow}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Body" Property="Opacity" Value="0.35" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="Foreground" Value="{StaticResource Cyan}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Body" CornerRadius="10" Background="Transparent" BorderThickness="1.5"
                            BorderBrush="{StaticResource Cyan}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Body" Property="Effect" Value="{StaticResource CyanGlow}" />
                            <Setter TargetName="Body" Property="Background" Value="#152D3A" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Body" Property="Effect" Value="{StaticResource CyanGlow}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Body" Property="Opacity" Value="0.35" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== Pestañas ===================== -->
    <Style TargetType="TabControl">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
    </Style>
    <!-- La fuente de la pestaña se aplica SOLO a su título (TextElement en el ContentPresenter);
         si se pusiera en el TabItem, se heredaría a todo el contenido de la pestaña. -->
    <Style TargetType="TabItem">
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Grid Margin="0,0,6,0">
                        <Border x:Name="Chip" CornerRadius="8,8,0,0" Padding="18,9" Background="Transparent">
                            <ContentPresenter x:Name="HeaderText" ContentSource="Header"
                                              TextElement.FontFamily="{StaticResource DisplayFont}"
                                              TextElement.FontSize="15" TextElement.FontWeight="SemiBold"
                                              TextElement.Foreground="{StaticResource TextDim}" />
                        </Border>
                        <Rectangle x:Name="Underline" Height="3" VerticalAlignment="Bottom" RadiusX="1.5" RadiusY="1.5"
                                   Fill="{StaticResource PrimaryGradient}" Visibility="Hidden" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="HeaderText" Property="TextElement.Foreground" Value="{StaticResource Text}" />
                            <Setter TargetName="Chip" Property="Background" Value="{StaticResource Surface}" />
                            <Setter TargetName="Underline" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="HeaderText" Property="TextElement.Foreground" Value="{StaticResource Text}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== Tablas ===================== -->
    <Style TargetType="DataGrid">
        <Setter Property="Background" Value="{StaticResource Surface}" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="BorderBrush" Value="{StaticResource Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="RowBackground" Value="Transparent" />
        <Setter Property="AlternatingRowBackground" Value="{StaticResource SurfaceAlt}" />
        <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource Line}" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="RowHeight" Value="30" />
        <Setter Property="AutoGenerateColumns" Value="False" />
        <Setter Property="CanUserAddRows" Value="False" />
        <Setter Property="CanUserDeleteRows" Value="False" />
        <Setter Property="SelectionMode" Value="Single" />
    </Style>
    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="#211B40" />
        <Setter Property="Foreground" Value="{StaticResource TextDim}" />
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="BorderBrush" Value="{StaticResource Line}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>
    <Style TargetType="DataGridCell">
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource SelectionBg}" />
                <Setter Property="Foreground" Value="{StaticResource Text}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ===================== Entradas ===================== -->
    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource SurfaceAlt}" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="CaretBrush" Value="{StaticResource Cyan}" />
        <Setter Property="BorderBrush" Value="{StaticResource Line}" />
        <Setter Property="SelectionBrush" Value="{StaticResource Magenta}" />
        <Setter Property="Padding" Value="6,4" />
    </Style>
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <!-- ===================== Barras de desplazamiento (delgadas, oscuras) ===================== -->
    <Style x:Key="ScrollThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="T" CornerRadius="4" Background="#4A3F86" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="T" Property="Background" Value="{StaticResource Cyan}" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="T" Property="Background" Value="{StaticResource Magenta}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="10" />
        <Setter Property="MinWidth" Value="10" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Border Background="{StaticResource Surface}" CornerRadius="5" Padding="2">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ScrollThumb}" />
                            </Track.Thumb>
                        </Track>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Height" Value="10" />
                <Setter Property="MinHeight" Value="10" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Border Background="{StaticResource Surface}" CornerRadius="5" Padding="2">
                                <Track x:Name="PART_Track" IsDirectionReversed="False">
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource ScrollThumb}" />
                                    </Track.Thumb>
                                </Track>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="ProgressBar">
        <Setter Property="Foreground" Value="{StaticResource Magenta}" />
        <Setter Property="Background" Value="{StaticResource SurfaceAlt}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <!-- Tarjeta: panel con borde neón suave -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Surface}" />
        <Setter Property="BorderBrush" Value="{StaticResource Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="14" />
    </Style>
</ResourceDictionary>
