<!--
  Dial circular estilo tacómetro: arco de 240°, marcas, arco de valor coloreado y aguja con giro suavizado.
  Solo presentación: recibe Value/Maximum y textos; no conoce de dónde salen.
-->
<UserControl x:Class="PulsoWin.App.Controls.Gauge"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Viewbox Stretch="Uniform">
        <Canvas Width="200" Height="200">
            <!-- Pista y marcas (se dibujan en código para calcular los ángulos) -->
            <Path x:Name="Track" Stroke="#2E2754" StrokeThickness="12" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
            <Path x:Name="ValueArc" StrokeThickness="12" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                <Path.Effect>
                    <DropShadowEffect x:Name="ArcGlow" BlurRadius="14" ShadowDepth="0" Opacity="0.8" />
                </Path.Effect>
            </Path>
            <Canvas x:Name="Ticks" />

            <!-- Aguja: gira alrededor del centro (100,108) -->
            <Polygon x:Name="Needle" Points="97,108 100,40 103,108" Fill="#EDE9FF">
                <Polygon.RenderTransform>
                    <RotateTransform x:Name="NeedleRotation" CenterX="100" CenterY="108" Angle="-120" />
                </Polygon.RenderTransform>
                <Polygon.Effect>
                    <DropShadowEffect Color="#FF3EA5" BlurRadius="10" ShadowDepth="0" Opacity="0.9" />
                </Polygon.Effect>
            </Polygon>
            <Ellipse Canvas.Left="91" Canvas.Top="99" Width="18" Height="18" Fill="#17132B" Stroke="#FF3EA5" StrokeThickness="2.5" />

            <!-- Textos -->
            <TextBlock x:Name="TitleText" Canvas.Left="0" Canvas.Top="122" Width="200" TextAlignment="Center"
                       FontFamily="Bahnschrift" FontSize="12" FontWeight="SemiBold" Foreground="#A79ED6" />
            <TextBlock x:Name="ValueTextBlock" Canvas.Left="0" Canvas.Top="138" Width="200" TextAlignment="Center"
                       FontFamily="Bahnschrift" FontSize="24" FontWeight="Bold" Foreground="#EDE9FF" />
            <TextBlock x:Name="SubTextBlock" Canvas.Left="0" Canvas.Top="168" Width="200" TextAlignment="Center"
                       FontFamily="Consolas" FontSize="11.5" Foreground="#A79ED6" />
            <TextBlock x:Name="ScaleTextBlock" Canvas.Left="0" Canvas.Top="184" Width="200" TextAlignment="Center"
                       FontFamily="Consolas" FontSize="10" Foreground="#6E64A8" />
        </Canvas>
    </Viewbox>
</UserControl>
