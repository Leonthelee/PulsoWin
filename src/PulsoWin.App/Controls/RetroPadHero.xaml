<!--
  Ilustración de cabecera: un mando retro ORIGINAL apuntando a un notebook.
  No reproduce el mando de ninguna consola real (sin logos, sin la combinación gris/negro/rojo):
  es un diseño propio en vector, animado con Storyboards.
  - Siempre: el texto parpadea y las estrellas titilan.
  - IsActive = true (analizando/limpiando): el rayo avanza, el cono brilla y las barras del notebook se llenan.
-->
<UserControl x:Class="PulsoWin.App.Controls.RetroPadHero"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.Name="Mando retro apuntando a un notebook">
    <UserControl.Resources>
        <Storyboard x:Key="IdleStory" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="CaptionText" Storyboard.TargetProperty="Opacity"
                             From="1" To="0.25" Duration="0:0:0.8" AutoReverse="True" />
            <DoubleAnimation Storyboard.TargetName="Stars" Storyboard.TargetProperty="Opacity"
                             From="0.35" To="0.9" Duration="0:0:1.6" AutoReverse="True" />
            <DoubleAnimation Storyboard.TargetName="Waves" Storyboard.TargetProperty="Opacity"
                             From="0.2" To="0.7" Duration="0:0:1.2" AutoReverse="True" />
        </Storyboard>

        <Storyboard x:Key="ActiveStory" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="BeamLine" Storyboard.TargetProperty="StrokeDashOffset"
                             From="0" To="-24" Duration="0:0:0.5" />
            <DoubleAnimation Storyboard.TargetName="BeamCone" Storyboard.TargetProperty="Opacity"
                             From="0.25" To="0.6" Duration="0:0:0.25" AutoReverse="True" />
            <DoubleAnimation Storyboard.TargetName="BtnA" Storyboard.TargetProperty="Opacity"
                             From="1" To="0.35" Duration="0:0:0.3" AutoReverse="True" />
            <DoubleAnimation Storyboard.TargetName="Bar1Scale" Storyboard.TargetProperty="ScaleX"
                             From="0.05" To="1" Duration="0:0:1.1" />
            <DoubleAnimation Storyboard.TargetName="Bar2Scale" Storyboard.TargetProperty="ScaleX"
                             From="0.05" To="1" Duration="0:0:1.1" BeginTime="0:0:0.3" />
            <DoubleAnimation Storyboard.TargetName="Bar3Scale" Storyboard.TargetProperty="ScaleX"
                             From="0.05" To="1" Duration="0:0:1.1" BeginTime="0:0:0.6" />
        </Storyboard>

        <LinearGradientBrush x:Key="PadBody" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#5A47B8" Offset="0" />
            <GradientStop Color="#2A2160" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="BeamBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#FF3EA5" Offset="0" />
            <GradientStop Color="#2DE2E6" Offset="1" />
        </LinearGradientBrush>
    </UserControl.Resources>

    <Viewbox Stretch="Uniform">
        <Canvas Width="660" Height="200" ClipToBounds="True">

            <!-- Piso de cuadrícula synthwave -->
            <Path Stroke="#2E2754" StrokeThickness="1" Opacity="0.9"
                  Data="M0,150 L660,150 M0,163 L660,163 M0,180 L660,180 M0,199 L660,199
                        M330,150 L330,200 M250,150 L170,200 M410,150 L490,200 M170,150 L10,200 M490,150 L650,200
                        M90,150 L-150,200 M570,150 L810,200" />
            <Rectangle Canvas.Top="149" Width="660" Height="2">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#00FF3EA5" Offset="0" />
                        <GradientStop Color="#FF3EA5" Offset="0.5" />
                        <GradientStop Color="#002DE2E6" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <!-- Estrellas de píxel -->
            <Canvas x:Name="Stars" Opacity="0.6">
                <Rectangle Canvas.Left="22" Canvas.Top="18" Width="3" Height="3" Fill="#EDE9FF" />
                <Rectangle Canvas.Left="118" Canvas.Top="8" Width="2" Height="2" Fill="#2DE2E6" />
                <Rectangle Canvas.Left="300" Canvas.Top="22" Width="3" Height="3" Fill="#FF3EA5" />
                <Rectangle Canvas.Left="365" Canvas.Top="10" Width="2" Height="2" Fill="#EDE9FF" />
                <Rectangle Canvas.Left="420" Canvas.Top="128" Width="2" Height="2" Fill="#2DE2E6" />
                <Rectangle Canvas.Left="640" Canvas.Top="30" Width="3" Height="3" Fill="#EDE9FF" />
                <Rectangle Canvas.Left="250" Canvas.Top="132" Width="2" Height="2" Fill="#EDE9FF" />
                <Rectangle Canvas.Left="60" Canvas.Top="132" Width="3" Height="3" Fill="#FF3EA5" />
            </Canvas>

            <!-- Rayo: cono suave + línea punteada que avanza -->
            <Polygon x:Name="BeamCone" Points="232,84 446,46 446,124" Opacity="0.18" Fill="{StaticResource BeamBrush}" />
            <Line x:Name="BeamLine" X1="232" Y1="84" X2="446" Y2="85" Stroke="{StaticResource BeamBrush}"
                  StrokeThickness="3" StrokeDashArray="3 3" StrokeDashCap="Round" Opacity="0.9">
                <Line.Effect>
                    <DropShadowEffect Color="#FF3EA5" BlurRadius="10" ShadowDepth="0" />
                </Line.Effect>
            </Line>
            <!-- Ondas de señal junto al emisor -->
            <Path x:Name="Waves" Stroke="#2DE2E6" StrokeThickness="2.5" StrokeEndLineCap="Round" StrokeStartLineCap="Round"
                  Opacity="0.4"
                  Data="M246,70 Q256,84 246,98 M260,62 Q274,84 260,106 M274,54 Q292,84 274,114" />

            <!-- Mando retro original (inclinado, apuntando al notebook) -->
            <Canvas Canvas.Left="34" Canvas.Top="56" Width="200" Height="96">
                <Canvas.RenderTransform>
                    <RotateTransform Angle="-10" CenterX="100" CenterY="48" />
                </Canvas.RenderTransform>
                <!-- Cable -->
                <Path Stroke="#6C5CE7" StrokeThickness="4" StrokeStartLineCap="Round"
                      Data="M2,48 C-24,48 -26,96 -48,130" />
                <!-- Cuerpo -->
                <Rectangle Width="200" Height="96" RadiusX="24" RadiusY="24" Fill="{StaticResource PadBody}"
                           Stroke="#2DE2E6" StrokeThickness="2.5">
                    <Rectangle.Effect>
                        <DropShadowEffect Color="#2DE2E6" BlurRadius="22" ShadowDepth="0" Opacity="0.75" />
                    </Rectangle.Effect>
                </Rectangle>
                <Rectangle Canvas.Left="10" Canvas.Top="10" Width="180" Height="76" RadiusX="17" RadiusY="17"
                           Fill="#1A1436" Opacity="0.75" />
                <!-- Cruceta -->
                <Rectangle Canvas.Left="38" Canvas.Top="24" Width="18" Height="48" RadiusX="3" RadiusY="3"
                           Fill="#0B0918" Stroke="#7B5CFF" StrokeThickness="1.2" />
                <Rectangle Canvas.Left="23" Canvas.Top="39" Width="48" Height="18" RadiusX="3" RadiusY="3"
                           Fill="#0B0918" Stroke="#7B5CFF" StrokeThickness="1.2" />
                <Rectangle Canvas.Left="39" Canvas.Top="40" Width="16" Height="16" Fill="#0B0918" />
                <!-- Marca propia + SELECT / START -->
                <TextBlock Canvas.Left="84" Canvas.Top="20" Text="PW" FontFamily="Bahnschrift" FontWeight="Bold"
                           FontSize="14" Foreground="#FF3EA5" />
                <Rectangle Canvas.Left="80" Canvas.Top="56" Width="18" Height="7" RadiusX="3.5" RadiusY="3.5" Fill="#7B5CFF" />
                <Rectangle Canvas.Left="104" Canvas.Top="56" Width="18" Height="7" RadiusX="3.5" RadiusY="3.5" Fill="#7B5CFF" />
                <!-- Botones de acción -->
                <Ellipse Canvas.Left="134" Canvas.Top="44" Width="22" Height="22" Fill="#2DE2E6" />
                <Ellipse x:Name="BtnA" Canvas.Left="160" Canvas.Top="28" Width="22" Height="22" Fill="#FF3EA5">
                    <Ellipse.Effect>
                        <DropShadowEffect Color="#FF3EA5" BlurRadius="12" ShadowDepth="0" />
                    </Ellipse.Effect>
                </Ellipse>
                <!-- Emisor en el borde frontal -->
                <Rectangle Canvas.Left="196" Canvas.Top="40" Width="9" Height="16" RadiusX="2" RadiusY="2" Fill="#FF3EA5" />
            </Canvas>

            <!-- Notebook -->
            <Rectangle Canvas.Left="446" Canvas.Top="26" Width="176" Height="112" RadiusX="9" RadiusY="9"
                       Fill="#120E24" Stroke="#2DE2E6" StrokeThickness="2.5">
                <Rectangle.Effect>
                    <DropShadowEffect Color="#2DE2E6" BlurRadius="18" ShadowDepth="0" Opacity="0.6" />
                </Rectangle.Effect>
            </Rectangle>
            <TextBlock Canvas.Left="460" Canvas.Top="36" Text="&gt; PULSO.EXE" FontFamily="Consolas" FontSize="12"
                       Foreground="#39FF88" />
            <!-- Barras de progreso -->
            <Rectangle Canvas.Left="460" Canvas.Top="60" Width="148" Height="10" RadiusX="3" RadiusY="3" Fill="#2E2754" />
            <Rectangle Canvas.Left="460" Canvas.Top="60" Width="148" Height="10" RadiusX="3" RadiusY="3" Fill="#FF3EA5">
                <Rectangle.RenderTransform><ScaleTransform x:Name="Bar1Scale" ScaleX="0.82" /></Rectangle.RenderTransform>
            </Rectangle>
            <Rectangle Canvas.Left="460" Canvas.Top="80" Width="148" Height="10" RadiusX="3" RadiusY="3" Fill="#2E2754" />
            <Rectangle Canvas.Left="460" Canvas.Top="80" Width="148" Height="10" RadiusX="3" RadiusY="3" Fill="#7B5CFF">
                <Rectangle.RenderTransform><ScaleTransform x:Name="Bar2Scale" ScaleX="0.55" /></Rectangle.RenderTransform>
            </Rectangle>
            <Rectangle Canvas.Left="460" Canvas.Top="100" Width="148" Height="10" RadiusX="3" RadiusY="3" Fill="#2E2754" />
            <Rectangle Canvas.Left="460" Canvas.Top="100" Width="148" Height="10" RadiusX="3" RadiusY="3" Fill="#2DE2E6">
                <Rectangle.RenderTransform><ScaleTransform x:Name="Bar3Scale" ScaleX="0.3" /></Rectangle.RenderTransform>
            </Rectangle>
            <!-- Base del notebook -->
            <Polygon Points="430,140 638,140 654,156 414,156" Fill="#2A2160" Stroke="#2DE2E6" StrokeThickness="2" />
            <Rectangle Canvas.Left="514" Canvas.Top="144" Width="40" Height="4" RadiusX="2" RadiusY="2" Fill="#7B5CFF" />

            <!-- Texto de estado -->
            <TextBlock x:Name="CaptionText" Canvas.Left="236" Canvas.Top="152" Width="200" TextAlignment="Center"
                       FontFamily="Bahnschrift" FontWeight="Bold" FontSize="22" Foreground="#FF3EA5"
                       Text="{Binding Caption, RelativeSource={RelativeSource AncestorType=UserControl}}">
                <TextBlock.Effect>
                    <DropShadowEffect Color="#FF3EA5" BlurRadius="14" ShadowDepth="0" />
                </TextBlock.Effect>
            </TextBlock>
        </Canvas>
    </Viewbox>
</UserControl>
