<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>

    <!-- Versión y metadatos que se ven en Propiedades → Detalles del .exe -->
    <Version>0.3.0</Version>
    <Product>PulsoWin</Product>
    <Company>PulsoWin (proyecto open source)</Company>
    <Copyright>Copyright (c) 2026 LeonThelee · MIT</Copyright>
    <Description>Limpiador y visor de hardware para Windows</Description>
    <!-- Builds reproducibles: el mismo código produce el mismo binario y no incrusta rutas locales. -->
    <Deterministic>true</Deterministic>
    <PathMap>$(MSBuildThisFileDirectory)=/src/</PathMap>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <!-- Limpia la ruta absoluta del .pdb en el encabezado CodeView (RSDS) del PE. -->
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="Author" Value="Daniel Elias Diaz Lepe (Leonthelee)" />
    <AssemblyMetadata Include="Profile" Value="https://www.linkedin.com/in/daniel-elías-diaz-lepe-6a4a6667" />
    <AssemblyMetadata Include="HelloDev" Value="Si llegaste hasta aqui con strings, ILSpy o REA: bienvenido colega. Codigo limpio, cero telemetria, cero drivers raros. Nos vemos en LinkedIn." />
  </ItemGroup>
</Project>
